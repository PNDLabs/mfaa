# ─── MFAA Environment Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Authentication ──────────────────────────────────────────────────────────────
# Set ONE of the following:

# Option 1 – plain-text password (simple, OK for home lab):
ACCESS_PASSWORD=changeme

# Option 2 – bcrypt hash (more secure; generate with: node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)")
# ACCESS_PASSWORD_HASH=$2a$12$...

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# Token validity period (e.g. 24h, 7d, 1h)
TOKEN_EXPIRY=24h

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
# When using cloudflared tunnel, add your tunnel domain here.
# Example: ALLOWED_ORIGINS=https://files.example.com,http://localhost:5173
ALLOWED_ORIGINS=*

# ── File browser ────────────────────────────────────────────────────────────────
# Set to true to show hidden files/directories (starting with .)
SHOW_HIDDEN=false
